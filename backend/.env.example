# Copie este arquivo para `.env` e ajuste o que for necessario.
# Todos os valores abaixo sao os padroes embutidos no codigo: sem um `.env`,
# a aplicacao sobe com estas configuracoes.

# Banco de dados. Arquivo SQLite relativo a pasta backend.
# Para usar PostgreSQL: postgresql+psycopg://usuario:senha@localhost:5432/residuogo
DATABASE_URL=sqlite:///./residuogo.db

# Chave de assinatura dos tokens JWT. TROQUE em qualquer uso real:
# quem tem esta chave consegue emitir um token valido para qualquer usuario.
JWT_SEGREDO=troque-este-segredo-em-producao
JWT_EXPIRACAO_MINUTOS=480

# Origens autorizadas a chamar a API pelo navegador (porta padrao do Vite).
CORS_ORIGENS=["http://localhost:5173","http://127.0.0.1:5173"]

# Integracoes externas (IBGE e ViaCEP).
HTTP_TIMEOUT_SEGUNDOS=5.0
