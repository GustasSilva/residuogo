      "get": {
        "tags": [
          "Organizações"
        ],
        "summary": "Lista organizações, com filtros",
        "description": "Lista participantes de forma paginada.\n\nO filtro `apenas_aptas` reutiliza exatamente as mesmas condições que a\nemissão do manifesto aplica (regra RN04), de modo que a tela nunca ofereça\num participante que a API depois recusaria.",
        "operationId": "listar_api_v1_organizacoes_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "papel",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/PapelOrganizacao"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtra pelo papel no ciclo do resíduo.",
              "title": "Papel"
            },
            "description": "Filtra pelo papel no ciclo do resíduo."
          },
          {
            "name": "apenas_aptas",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Quando verdadeiro, devolve apenas organizações ativas e com licença ambiental válida. Exige que `papel` seja informado. É o filtro usado pela tela de novo manifesto.",
              "default": false,
              "title": "Apenas Aptas"
            },
            "description": "Quando verdadeiro, devolve apenas organizações ativas e com licença ambiental válida. Exige que `papel` seja informado. É o filtro usado pela tela de novo manifesto."
          },
          {
            "name": "busca",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Texto procurado na razão social ou no CNPJ.",
              "title": "Busca"
            },
            "description": "Texto procurado na razão social ou no CNPJ."
          },
          {
            "name": "pagina",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Pagina atual, comecando em 1.",
              "default": 1,
              "title": "Pagina"
            },
            "description": "Pagina atual, comecando em 1."
          },
          {
            "name": "tamanho",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Registros por pagina.",
              "default": 20,
              "title": "Tamanho"
            },
            "description": "Registros por pagina."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pagina_OrganizacaoSaida_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
