{
  "openapi": "3.1.0",
  "info": {
    "title": "ResíduoGO",
    "description": "\nSistema de rastreamento de resíduos sólidos para organizações do estado de Goiás.\n\nRegistra o ciclo completo de um lote de resíduo — **gerador → transportador →\ndestinador** — em um manifesto digital, que cada participante atualiza por esta API.\n\nO sistema expõe os dois estilos de web service:\n\n* **REST**, documentado aqui, em `/api/v1`;\n* **SOAP**, com contrato WSDL em `/soap/manifesto?wsdl`.\n\nTodas as respostas de erro seguem a **RFC 7807** (`application/problem+json`).\n",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Autentica o usuário e devolve o token de acesso",
        "description": "Troca e-mail e senha por um token JWT.\n\nA mesma mensagem de erro e usada para e-mail inexistente e para senha\nerrada. Diferenciar as duas situacoes permitiria descobrir quais e-mails\nestao cadastrados no sistema testando um a um.",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginEntrada"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenSaida"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Dados do usuário autenticado e da organização dele",
        "description": "Devolve quem esta logado.\n\nO front-end chama esta rota ao abrir a aplicacao: e dela que sai o papel\nda organizacao, que determina quais acoes aparecem em cada manifesto.",
        "operationId": "usuario_logado_api_v1_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioLogadoSaida"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
