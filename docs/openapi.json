    "/soap/manifesto": {
      "get": {
        "tags": [
          "Web Service SOAP"
        ],
        "summary": "Contrato WSDL do serviço SOAP",
        "description": "Devolve o WSDL do servico.\n\nO endereco publicado dentro do documento e a propria URL desta\nrequisicao, sem a query string. Assim o WSDL funciona tanto em\n`localhost` quanto em qualquer outro host, sem configuracao.",
        "operationId": "obter_wsdl_soap_manifesto_get",
        "responses": {
          "200": {
            "description": "Successful Response"
          }
        }
      },
      "post": {
        "tags": [
          "Web Service SOAP"
        ],
        "summary": "Executa uma operação SOAP (corpo: envelope XML)",
        "description": "Recebe um envelope SOAP, executa a operacao e devolve a resposta.\n\nA sequencia de verificacoes vai do envelope para o conteudo: primeiro se a\nmensagem e XML valido, depois se a operacao existe, depois se os\nparametros vieram, e so no fim a regra de negocio. Cada falha produz um\nSOAP Fault com codigo proprio, o que permite ao cliente distinguir\n\"mensagem mal formada\" de \"manifesto inexistente\".",
        "operationId": "atender_soap_manifesto_post",
        "responses": {
          "200": {
            "description": "Successful Response"
          }
        }
      }
    },
